<Page
    x:Class="Lumibooks.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lumibooks">

    <Page.Resources>
        <DataTemplate x:Key="RowTemplate" x:DataType="local:StatRow">
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="44" Height="66" Source="{x:Bind Cover}" Stretch="Uniform" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Line1}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Line2}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Pivot Title="STATISTICS">
            <PivotItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,16">
                        <Grid x:Name="Tiles" Margin="-4,4,-4,0" />
                        <TextBlock Text="Last 14 days" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,20,0,0" />
                        <Grid x:Name="Chart" Height="140" Margin="0,12,0,0" />
                        <Grid x:Name="ChartLabels" Margin="0,4,0,0" />
                        <TextBlock x:Name="ChartNote" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Books">
                <Grid>
                    <TextBlock x:Name="NoBooks" Text="Statistics appear here once you start reading." Opacity="0.7" TextWrapping="Wrap" Margin="0,12" Visibility="Collapsed" />
                    <ListView x:Name="BookList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnBookClick" ItemTemplate="{StaticResource RowTemplate}" />
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
