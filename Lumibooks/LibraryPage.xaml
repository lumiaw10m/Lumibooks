<Page
    x:Class="Lumibooks.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lumibooks"
    NavigationCacheMode="Required">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="LUMIBOOKS" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Margin="12,12,12,8" />
        <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="12" TextWrapping="Wrap" Opacity="0.7"
                   Text="Your library is empty. Use Import to add EPUB books." />
        <GridView Grid.Row="1" ItemsSource="{x:Bind Books}" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="OnItemClick" Padding="8,0,0,8">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:Book">
                    <Grid Width="104" Height="196" Holding="OnHolding" RightTapped="OnRightTapped">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="156" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontSize="13" Margin="8" />
                        </Border>
                        <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                        <TextBlock Grid.Row="1" Text="{x:Bind Author}" FontSize="12" Opacity="0.7" Margin="0,4,0,0"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Icon="Add" Label="Import" Click="OnImport" />
        </CommandBar>
    </Page.BottomAppBar>
</Page>
