<Page
    x:Class="Lumibooks.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lumibooks"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="BookTemplate" x:DataType="local:Book">
            <Grid Width="104" Height="216" Holding="OnHolding" RightTapped="OnRightTapped">
                <Grid.RowDefinitions>
                    <RowDefinition Height="156" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontSize="13" Margin="8" />
                </Border>
                <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                <Border Visibility="{x:Bind FavoriteVisibility}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="#99000000" Padding="4" Margin="0,4,4,0">
                    <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="#ffd600" />
                </Border>
                <ProgressBar Value="{x:Bind Percent}" Maximum="100" VerticalAlignment="Bottom" MinHeight="4" Height="4"
                             Background="#99000000" Foreground="{ThemeResource SystemControlBackgroundAccentBrush}" Visibility="{x:Bind ProgressVisibility}" />
                <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontSize="14" Margin="0,6,0,0"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Author}" FontSize="12" Opacity="0.6" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{x:Bind PercentText}" FontSize="12" Opacity="0.6" Margin="4,0,0,0" />
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ContinueTemplate" x:DataType="local:Book">
            <Grid Margin="0,0,12,12" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="52" Height="76">
                    <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" />
                    <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,6,12,6" VerticalAlignment="Center">
                    <TextBlock Text="CONTINUE READING" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Value="{x:Bind Percent}" Maximum="100" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind PercentText}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox x:Name="SearchBox" Margin="12,12,12,0" PlaceholderText="Search titles and authors" InputScope="Search"
                 Visibility="Collapsed" TextChanged="OnSearchChanged" KeyDown="OnSearchKey" />
        <Pivot x:Name="Shelves" Grid.Row="1" Title="LUMIBOOKS" SelectionChanged="OnShelfChanged" />
    </Grid>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Icon="Add" Label="Import" Click="OnImport" />
            <AppBarButton Icon="Find" Label="Search" Click="OnSearch" />
            <AppBarButton Label="Sort" Click="OnSort">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8CB;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Notes" Click="OnNotes">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8A4;" /></AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="New shelf" Click="OnNewShelf" />
                <AppBarButton x:Name="RenameShelfButton" Label="Rename shelf" Click="OnRenameShelf" Visibility="Collapsed" />
                <AppBarButton x:Name="DeleteShelfButton" Label="Delete shelf" Click="OnDeleteShelf" Visibility="Collapsed" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
